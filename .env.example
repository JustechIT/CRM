# Supabase project URL and public publishable key; never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: server-only Supabase secret/service-role key, required ONLY for Super Admin invitations.
# Never prefix this variable with NEXT_PUBLIC or commit .env.local.
SUPABASE_SECRET_KEY=
